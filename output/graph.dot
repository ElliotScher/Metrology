  "metre" [label="Metre\n(m)", fillcolor="#1b5e20", fontcolor="white"];
  "mole" [label="Mole\n(mol)", fillcolor="#1b5e20", fontcolor="white"];
  "newton" [label="Newton\n(N)", fillcolor="#1565c0", fontcolor="white"];
  "ohm" [label="Ohm\n(Ω)", fillcolor="#1565c0", fontcolor="white"];
  "pascal" [label="Pascal\n(Pa)", fillcolor="#1565c0", fontcolor="white"];
  "radian" [label="Radian\n(rad)", fillcolor="#1565c0", fontcolor="white"];
  "second" [label="Second\n(s)", fillcolor="#1b5e20", fontcolor="white"];
  "siemens" [label="Siemens\n(S)", fillcolor="#1565c0", fontcolor="white"];
  "steradian" [label="Steradian\n(sr)", fillcolor="#1565c0", fontcolor="white"];
  "tesla" [label="Tesla\n(T)", fillcolor="#1565c0", fontcolor="white"];
  "volt" [label="Volt\n(V)", fillcolor="#1565c0", fontcolor="white"];
  "watt" [label="Watt\n(W)", fillcolor="#1565c0", fontcolor="white"];
