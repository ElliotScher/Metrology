  "kelvin" -> "celsius" [label=""];
  "ampere" -> "coulomb" [label=""];
  "second" -> "coulomb" [label=""];
  "coulomb" -> "farad" [label=""];
  "volt" -> "farad" [label="^-1"];
  "weber" -> "henry" [label=""];
  "ampere" -> "henry" [label="^-1"];
  "second" -> "hertz" [label="^-1"];
  "newton" -> "joule" [label=""];
  "metre" -> "joule" [label=""];
  "mole" -> "katal" [label=""];
  "second" -> "katal" [label="^-1"];
