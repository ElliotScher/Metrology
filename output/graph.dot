digraph metrology {
  rankdir="TB";
  node [shape=box, style=filled, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  "level-0" [label="Level 0", shape=plaintext, style="", fontcolor="#616161"];
  "level-1" [label="Level 1", shape=plaintext, style="", fontcolor="#616161"];
  "level-2" [label="Level 2", shape=plaintext, style="", fontcolor="#616161"];
  "level-3" [label="Level 3", shape=plaintext, style="", fontcolor="#616161"];
  "level-4" [label="Level 4", shape=plaintext, style="", fontcolor="#616161"];
  "level-5" [label="Level 5", shape=plaintext, style="", fontcolor="#616161"];
  "level-6" [label="Level 6", shape=plaintext, style="", fontcolor="#616161"];
  "level-0" -> "level-1" [style=invis, weight=100];
  "level-1" -> "level-2" [style=invis, weight=100];
  "level-2" -> "level-3" [style=invis, weight=100];
  "level-3" -> "level-4" [style=invis, weight=100];
  "level-4" -> "level-5" [style=invis, weight=100];
  "level-5" -> "level-6" [style=invis, weight=100];
  "ampere" [label="Ampere\n(A)", fillcolor="#1b5e20", fontcolor="white"];
  "candela" [label="Candela\n(cd)", fillcolor="#1b5e20", fontcolor="white"];
  "celsius" [label="Degree Celsius\n(°C)", fillcolor="#1565c0", fontcolor="white"];
  "coulomb" [label="Coulomb\n(C)", fillcolor="#1565c0", fontcolor="white"];
  "farad" [label="Farad\n(F)", fillcolor="#1565c0", fontcolor="white"];
  "henry" [label="Henry\n(H)", fillcolor="#1565c0", fontcolor="white"];
  "hertz" [label="Hertz\n(Hz)", fillcolor="#1565c0", fontcolor="white"];
  "joule" [label="Joule\n(J)", fillcolor="#1565c0", fontcolor="white"];
  "katal" [label="Katal\n(kat)", fillcolor="#1565c0", fontcolor="white"];
  "kelvin" [label="Kelvin\n(K)", fillcolor="#1b5e20", fontcolor="white"];
  "kilogram" [label="Kilogram\n(kg)", fillcolor="#1b5e20", fontcolor="white"];
  "lumen" [label="Lumen\n(lm)", fillcolor="#1565c0", fontcolor="white"];
  "lux" [label="Lux\n(lx)", fillcolor="#1565c0", fontcolor="white"];
  "metre" [label="Metre\n(m)", fillcolor="#1b5e20", fontcolor="white"];
  "mole" [label="Mole\n(mol)", fillcolor="#1b5e20", fontcolor="white"];
  "newton" [label="Newton\n(N)", fillcolor="#1565c0", fontcolor="white"];
  "ohm" [label="Ohm\n(Ω)", fillcolor="#1565c0", fontcolor="white"];
  "pascal" [label="Pascal\n(Pa)", fillcolor="#1565c0", fontcolor="white"];
  "radian" [label="Radian\n(rad)", fillcolor="#1565c0", fontcolor="white"];
  "second" [label="Second\n(s)", fillcolor="#1b5e20", fontcolor="white"];
  "siemens" [label="Siemens\n(S)", fillcolor="#1565c0", fontcolor="white"];
  "steradian" [label="Steradian\n(sr)", fillcolor="#1565c0", fontcolor="white"];
  "tesla" [label="Tesla\n(T)", fillcolor="#1565c0", fontcolor="white"];
  "volt" [label="Volt\n(V)", fillcolor="#1565c0", fontcolor="white"];
  "watt" [label="Watt\n(W)", fillcolor="#1565c0", fontcolor="white"];
  "weber" [label="Weber\n(Wb)", fillcolor="#1565c0", fontcolor="white"];
  { rank=same; "level-0"; "ampere"; "candela"; "kelvin"; "second"; "kilogram"; "metre"; "mole"; }
  { rank=same; "level-1"; "celsius"; "coulomb"; "newton"; "hertz"; "katal"; "steradian"; "radian"; }
  { rank=same; "level-2"; "joule"; "lumen"; "pascal"; }
  { rank=same; "level-3"; "watt"; "lux"; }
  { rank=same; "level-4"; "volt"; }
  { rank=same; "level-5"; "farad"; "weber"; "ohm"; "siemens"; }
  { rank=same; "level-6"; "henry"; "tesla"; }
  "kelvin" -> "celsius" [label=""];
  "ampere" -> "coulomb" [label=""];
  "second" -> "coulomb" [label=""];
  "coulomb" -> "farad" [label=""];
  "volt" -> "farad" [label="^-1"];
  "weber" -> "henry" [label=""];
  "ampere" -> "henry" [label="^-1"];
  "second" -> "hertz" [label="^-1"];
  "newton" -> "joule" [label=""];
  "metre" -> "joule" [label=""];
  "mole" -> "katal" [label=""];
  "second" -> "katal" [label="^-1"];
  "candela" -> "lumen" [label=""];
  "steradian" -> "lumen" [label=""];
  "lumen" -> "lux" [label=""];
  "metre" -> "lux" [label="^-2"];
  "kilogram" -> "newton" [label=""];
  "metre" -> "newton" [label=""];
  "second" -> "newton" [label="^-2"];
  "volt" -> "ohm" [label=""];
  "ampere" -> "ohm" [label="^-1"];
  "newton" -> "pascal" [label=""];
  "metre" -> "pascal" [label="^-2"];
  "metre" -> "radian" [label="^1, ^-1"];
  "ampere" -> "siemens" [label=""];
  "volt" -> "siemens" [label="^-1"];
  "metre" -> "steradian" [label="^2, ^-2"];
  "weber" -> "tesla" [label=""];
  "metre" -> "tesla" [label="^-2"];
  "watt" -> "volt" [label=""];
  "ampere" -> "volt" [label="^-1"];
  "joule" -> "watt" [label=""];
  "second" -> "watt" [label="^-1"];
  "volt" -> "weber" [label=""];
  "second" -> "weber" [label=""];
  "kelvin" -> "celsius" [dir=none, constraint=false, style=dashed, color="#9e9e9e", fontcolor="#616161", label="historical-connection"];
}
